[Unit]
Description=Hyprdrop Background Daemon for Hyprland
Documentation=https://github.com/Ubaidullah-Web-Dev/Hyprdrop
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/.local/lib:/usr/local/lib
ExecStart=/usr/bin/hyprdrop --daemon
Restart=on-failure
RestartSec=2s
Slice=app.slice

[Install]
WantedBy=graphical-session.target
