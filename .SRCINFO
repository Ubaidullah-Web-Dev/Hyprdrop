pkgbase = hyprdrop
	pkgdesc = Radial drag-and-drop file converter, quick-action editor, and drop-shelf utility for Hyprland
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/hyprland-community/hyprdrop
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = pkgconf
	depends = gtk4
	depends = libadwaita
	depends = gtk4-layer-shell
	depends = cairo
	depends = ffmpeg
	optdepends = poppler: for high-DPI PDF page rasterization (pdftoppm)
	optdepends = tesseract: for OCR text extraction from images
	optdepends = wl-clipboard: for direct Wayland clipboard copy support
	optdepends = pandoc: for document format conversion (Markdown/DOCX)
	optdepends = hyprland: for native compositor overlay blur and cursor anchoring
